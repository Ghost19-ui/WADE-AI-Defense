{
  "manifest_version": 3,
  "name": "WADE - AI Defense Engine",
  "version": "4.2",
  "description": "Real-time AI cybersecurity protection for browsers.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "notifications"
],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "hover_script.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  }
}